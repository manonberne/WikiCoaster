{% extends "base.html.twig" %}

{% block body %}
<div class="flex justify-end my-4">
    <a class="btn btn-neutral" href="{{ path('app_coaster_add') }}">Nouveau coaster</a>
</div>
<div>
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Max speed</th>
                <th>Length</th>
                <th>max height</th>
                <th>Park</th>
                <th>Categorys</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            {% for coaster in coasters %}
                <tr>
                    <td>{{ coaster.name }}</td>
                    <td>{{ coaster.maxSpeed }}</td>
                    <td>{{ coaster.length }}</td>
                    <td>{{ coaster.maxHeight }}</td>
                    <td>{{ coaster.park ? coaster.park.name : '-'}}</td>
                    <td>
                        {% for category in coaster.categorys %}
                            <span class="badge" style="background-color: {{ category.color }};">
                                {{ category.name }}
                            </span>
                        {% endfor %}
                    </td>
                    <td>
                        <a href="{{ path('app_coaster_edit', {'id':coaster.id}) }}" class="btn btn-primary">Modifier</a>
                        <a href="{{ path('app_coaster_delete', {'id':coaster.id}) }}" class="btn btn-danger">Supprimer</a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}