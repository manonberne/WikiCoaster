{% extends "base.html.twig" %}

{% block body %}
<div class="flex justify-end my-4">
    <a class="btn btn-neutral" href="{{ path('app_coaster_add') }}">Nouveau coaster</a>
</div>
<div>
    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Max speed</th>
                <th>Length</th>
                <th>max height</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            {% for coaster in coasters %}
                <tr>
                    <td>{{ coaster.name }}</td>
                    <td>{{ coaster.maxSpeed }}</td>
                    <td>{{ coaster.length }}</td>
                    <td>{{ coaster.maxHeight }}</td>
                    <td></td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}